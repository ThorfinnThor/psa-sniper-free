# Required: eBay Production keys
EBAY_CLIENT_ID=your-production-client-id
EBAY_CLIENT_SECRET=your-production-client-secret

# Required for the encrypted state branch and encrypted dashboard.
# Use a unique passphrase with at least 16 characters.
DASHBOARD_PASSWORD=replace-with-a-long-random-passphrase

# Optional official PSA Public API bearer token; the public cert-page fallback
# remains available when this value is blank.
PSA_ACCESS_TOKEN=

# Optional free notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional OCR; install Tesseract plus requirements-ocr.txt first.
ENABLE_OCR=false

# Optional private JSON configuration overrides
SEARCH_CONFIG_JSON=
SETTINGS_OVERRIDE_JSON=

# Runtime
STATE_PATH=data/state.json
PRIVACY_MODE=false
